{
  "name": "bobcoin-node",
  "version": "2.5.0",
  "description": "Node which hosts and synchronizes a copy of the entire Bobcoin blockchain.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch -r ts-node/register --env-file=env/.env src/index.ts",
    "dev:mainnet:alpha": "node --watch -r ts-node/register --env-file=env/alpha.mainnet.env src/index.ts",
    "dev:testnet:alpha": "node --watch -r ts-node/register --env-file=env/alpha.testnet.env src/index.ts",
    "dev:testnet:beta": "node --watch -r ts-node/register --env-file=env/beta.testnet.env src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "tsc",
    "dump:testnet:alpha": "cross-env DOTENV_CONFIG_PATH=env/alpha.testnet.env ts-node -r dotenv/config src/scripts/dumpBlockchain.ts",
    "read": "ts-node src/scripts/readBlockchain.ts dumps/mainnet.json",
    "prune:mainnet:alpha": "cross-env DOTENV_CONFIG_PATH=env/alpha.mainnet.env ts-node -r dotenv/config src/scripts/pruneBlockchain.ts",
    "prune:testnet:alpha": "cross-env DOTENV_CONFIG_PATH=env/alpha.testnet.env ts-node -r dotenv/config src/scripts/pruneBlockchain.ts",
    "mine": "ts-node src/scripts/mine.ts",
    "fork-miner": "cross-env DOTENV_CONFIG_PATH=env/alpha.mainnet.env ts-node -r dotenv/config src/scripts/forkMiner.ts",
    "aws-deploy": "git pull && npm run build && pm2 restart 0",
    "delete": "ts-node src/scripts/deleteBlocks.ts",
    "profile": "npm run build && clinic doctor -- node dist/index.js"
  },
  "nodemonConfig": {
    "ignore": [
      "src/scripts/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BobShoaun/Bobcoin-Backend-Node.git"
  },
  "author": "Bob Shoaun Ng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BobShoaun/Bobcoin-Backend-Node/issues"
  },
  "homepage": "https://github.com/BobShoaun/Bobcoin-Backend-Node#readme",
  "dependencies": {
    "axios": "^0.25.0",
    "blockcrypto": "^4.2.0",
    "clean": "^4.0.2",
    "cors": "^2.8.5",
    "date-fns": "^2.28.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-queue": "^0.0.13",
    "express-rate-limit": "^6.6.0",
    "mongoose": "^7.8.9",
    "morgan": "^1.10.0",
    "socket.io": "^4.0.1",
    "socket.io-client": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/morgan": "^1.9.3",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=14"
  }
}
